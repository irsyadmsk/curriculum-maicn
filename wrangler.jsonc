{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "curriculum-maicn",
  "compatibility_date": "2026-07-02",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "."
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    {
      "pattern": "curriculum.irsyads.com",
      "custom_domain": true
    }
  ]
}
