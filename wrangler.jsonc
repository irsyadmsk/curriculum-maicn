{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "curriculum-maicn",
  "main": "server/worker.mjs",
  "build": { "command": "node scripts/build-site.mjs" },
  "compatibility_date": "2026-07-02",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".site",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "vars": { "ACCESS_ENABLED": "false", "CLINIC_ENABLED": "false" },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    {
      "pattern": "curriculum.irsyads.com",
      "custom_domain": true
    }
  ]
}
